.claude/*.local.json
__pycache__/

# Generated by scripts/build_features.py from kb/<vendor>/<id>.yaml (the source of truth).
# The app fetches it at runtime, so CI rebuilds it before validating and before deploying.
# Untracked on purpose: an entry's diff should be its own small YAML file, not a hunk
# buried in a 2,500-line array that also churns every time the file is regenerated.
/www/databricks.features.json

# Generated by scripts/build_entries.py (regenerated in CI before deploy).
# The kb/ entries are the source of truth; these are build output, not source.
# The trailing slash matches the directory only.
/www/databricks/
/reference/
/www/sitemap.xml
/www/feed.xml
